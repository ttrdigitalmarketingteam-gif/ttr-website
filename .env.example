# Copy to .env.local for local development. Never commit real values.

# Sanity (public, safe to expose)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Public site address used for canonical URLs, sitemap and Open Graph tags
NEXT_PUBLIC_SITE_URL=https://ttrdigitalmarketing.com

# Shared secret for the Sanity webhook that calls /api/revalidate
SANITY_REVALIDATE_SECRET=

# GoHighLevel. Without these, form leads are logged with a warning instead of sent.
GHL_API_KEY=
GHL_LOCATION_ID=

# Only for scripts (seed, WordPress import) when no API credential adds auth for you
SANITY_API_WRITE_TOKEN=
